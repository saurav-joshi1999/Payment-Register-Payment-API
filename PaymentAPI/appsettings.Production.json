{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.ApplicationInsights"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "ApplicationInsights",
                "Args": {
                    "connectionString": "REPLACE_WITH_AZURE_APP_SETTING_OR_APPINSIGHTS_CONNECTION_STRING",
                    "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
                }
            }
        ]
    },
    "ConnectionStrings": {
        "DevConnection": "THIS_WILL_BE_OVERRIDDEN_BY_AZURE_APP_SETTINGS"
    },
    "AllowedCorsOrigins": "https://your-production-domain.com"
}